---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatPublicationDisplay, sortPublications } from '../lib/content-policy.mjs';

const publicationEntries = await getCollection('publications');
const publications = publicationEntries
  .map((entry) => ({
    slug: entry.slug,
    ...entry.data,
    display: formatPublicationDisplay(entry.data)
  }));

const sortedPublications = sortPublications(publications);
---

<BaseLayout
  pageTitle="Publications"
  description="All papers, technical reports, and team releases by Rui Xie."
>
  <section class="page-heading panel" data-reveal>
    <span class="eyebrow">Publications</span>
    <h1>Papers, technical reports, and team releases.</h1>
    <p>
      Explore my work across agent interfaces, computer use, training, and real-environment evaluation,
      with links to papers, project pages, code, models, and datasets.
    </p>
  </section>

  <section class="section-block" data-reveal="2">
    <div class="list-stack">
      {sortedPublications.map((publication) => (
        <article class="list-item">
          <div class="mini-meta">
            <span class:list={['status-badge', { warm: publication.status !== 'published' }]}>
              {publication.display.label}
            </span>
            <span>{publication.role}</span>
            <span>{publication.year}</span>
          </div>
          <h3>{publication.title}</h3>
          <p>{publication.authorDisplay ?? publication.authors.join(', ')}</p>
          <p>{publication.summary}</p>
          {publication.links.length > 0 && (
            <div class="link-pills">
              {publication.links.map((link) => (
                <a class="link-pill" href={link.href}>{link.label}</a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
